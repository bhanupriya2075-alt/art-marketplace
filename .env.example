# ---- Server ----
PORT=4100
NODE_ENV=development

# ---- PostgreSQL ----
DATABASE_URL=postgresql://marketplace_app:StrongPassword123!@localhost:5432/marketplace_db
PGHOST=localhost
PGPORT=5432
PGUSER=marketplace_app
PGPASSWORD=StrongPassword123!
PGDATABASE=marketplace_db
PGSSL=false

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Demo seed password (npm run seed) ----
SEED_PASSWORD=Passw0rd!
